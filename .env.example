# Postgres connection string. The `migrations/` are applied automatically
# on startup.
DATABASE_URL=postgres://user:pass@localhost/concord

# Secret used to sign the JWTs issued after wallet-signature verification.
# Generate a real one for anything beyond local dev, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me

# Soroban RPC endpoint the indexer polls.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# The deployed concord-escrow contract's address (starts with "C").
# See ../concord-contracts/DEPLOYMENTS.md for the current testnet deployment.
ESCROW_CONTRACT_ID=CCV6TXXCFDFC743XMQBRICV4HFMKRPDDCPUQFKOWVYZ3BNJEGEDQODSO

PORT=8080
INDEXER_POLL_INTERVAL_SECS=5
